    <!--
      Durations that can be short are rendered from these rather than from value_minutes.
      Integer minutes turn a 16 second pause into "0 min", which reads as though nothing was
      recorded at all — the same trap the AI prompt already avoids by reporting seconds.
    -->
    <string name="value_seconds">%1$d s</string>
