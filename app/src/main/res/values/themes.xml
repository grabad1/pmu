<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme. The Compose theme in ui/elements/theme drives the actual colours;
         this exists so the window background matches before Compose draws. -->
    <style name="Theme.FocusGuard" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
